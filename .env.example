# OpsRoom Environment Configuration

# Execution Mode: set to 'true' for zero-cost, zero-friction local simulation (recommended for hackathon evaluation)
MOCK_AWS=true
MOCK_PORT=8080
MOCK_APP_URL=http://localhost:8080

# AWS Configuration (Used when MOCK_AWS=false)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ALB_TARGET_GROUP_ARN=
AWS_EC2_INSTANCE_ID=
AWS_SSM_DOCUMENT_NAME=AWS-RunShellScript

# Operational Parameters
INCIDENT_TARGET_NAME=guidra-production
AUTHORIZED_APPROVER_ROLES=admin,lead-sre,human-engineer
APPROVAL_SECRET_PREFIX=APPROVE

# Autonomous Sentinel Watcher (Optional: auto-broadcasts alerts into Telegram chat on failure)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-5406584912
WATCH_INTERVAL_MS=5000
